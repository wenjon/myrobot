# ============================================================
# myrobot 环境变量样例
# 用法：复制为仓库根目录的 .env 并填入自己的密钥。
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交。
# 完整配置项说明见 docs/superpowers/specs/2026-07-27-robot-head-design.md 第 13 章。
# ============================================================

# ---- LLM 供应商：maas（阿里云百炼，云端，默认）| ark（火山引擎，云端）| ollama（本地）| llamacpp（本地 llama.cpp OpenAI 兼容服务）----
LLM_PROVIDER=maas

# 阿里云百炼 Model Studio（OpenAI 兼容 /compatible-mode/v1）。LLM_PROVIDER=maas 时必填 MAAS_API_KEY。
MAAS_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MAAS_API_KEY=
MAAS_MODEL=qwen3.6-flash
# Qwen3 思考模式：1=先输出思考过程（慢），0=直接作答（语音对话推荐）
MAAS_ENABLE_THINKING=0

# 火山引擎 Ark（OpenAI 兼容）。LLM_PROVIDER=ark 时必填 ARK_API_KEY。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_API_KEY=
ARK_MODEL=ark-code-latest

# 本地 Ollama（LLM_PROVIDER=ollama 时使用，无需密钥）
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b

# 本地 llama.cpp server（OpenAI 兼容 /v1/chat/completions）。
# LLM_PROVIDER=llamacpp 时使用：默认无需 key；如服务要求鉴权再填 LLAMACPP_API_KEY。
# 适用：本地 3090 上的 Qwen3.6-35B-A3B MTP（带 1024 token 推理预算）。
LLAMACPP_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=Qwen3.6-35B-A3B-MTP
LLAMACPP_API_KEY=

# ---- 联网搜索工具 Tavily ----
# 留空则 web_search 工具不可用，其余链路照常工作。
# 申请地址：https://app.tavily.com
TAVILY_API_KEY=

# ---- TTS 语音合成 ----
# TTS_ENGINE=edge 用 Edge 神经语音（自然度高，需 pip install edge-tts，走网络）
#            web  用浏览器 Web Speech（离线，但 Windows 上只有 SAPI 老音色）
# edge 合成失败时前端自动降级到 web，不会哑掉。
TTS_ENGINE=edge
# 中文音色共 14 个，跑 python scripts/tts_preview.py 生成试听样本后再挑。
# 常用：XiaoyiNeural(活泼少女) / XiaoxiaoNeural(温暖女声) / YunxiaNeural(男童声)
TTS_VOICE=zh-CN-XiaoyiNeural
# 相对量语法：rate/volume 用百分比，pitch 用 Hz
TTS_RATE=+8%
TTS_PITCH=+10Hz
TTS_VOLUME=+0%
# 韵律风格（抑扬顿挫）：broadcast 播音腔 / natural 日常口语 / flat 关闭
# Edge 免费端点不收 SSML，句内起伏靠"拆段+逐段参数+服务端拼接"实现，详见 docs 第 18.6。
TTS_PROSODY=broadcast

# ---- 服务监听 ----
HOST=127.0.0.1
PORT=8000

# ---- 语音识别（ASR，浏览器 Web Speech）----
# 1=打开页面即自动常开麦克风监听，识别到停顿自动发送（默认）；0=必须手动点麦克风
VOICE_AUTOSTART=1
# 静音多久判定"这句话说完了"并自动提交给大模型（毫秒）
VOICE_SILENCE_MS=1200
# 小柚播完后再等多久才重新开麦（毫秒）。留这段是为了让喇叭余音/混响衰减掉，
# 否则麦克风会把它自己的尾音听成用户输入（回声自激）。300~500 比较稳。
VOICE_RESUME_DELAY_MS=400
ASR_LANG=zh-CN

# ---- 视觉（双目/单目相机 → 识别 + 深度，前端左下角浮层）----
# 可选：需要 opencv-python + ultralytics，并把 YOLO 权重放到 backend/vision/weights/。
# 依赖缺失或相机不可用时整块自动关闭，对话不受影响。
VISION_ENABLED=1
# auto=依次试 双目并排 → 单目 → 双相机；也可固定 single / dual / mono
VISION_CAMERA_MODE=auto
# 单目或双目并排相机用这个索引；dual 模式才用 LEFT/RIGHT 两个索引
VISION_CAMERA_INDEX=0
VISION_LEFT_INDEX=0
VISION_RIGHT_INDEX=1
VISION_WIDTH=640
VISION_HEIGHT=480
# 双目标定：距离 = focal_length × baseline / disparity。
# 只在接上双目相机后才用得到；不标定距离不准（物理量，代码猜不出）。
VISION_FOCAL_LENGTH=700.0
VISION_BASELINE=0.06
# YOLO 检测：CPU 上隔帧检测（默认每 3 帧一次），中间帧靠追踪器兜住
VISION_YOLO_MODEL=yolov8n.pt
VISION_YOLO_CONF=0.4
VISION_YOLO_DEVICE=cpu
VISION_DETECT_EVERY_N=3
# 权重搜索目录（可选）。默认顺序：backend/vision/weights/ → 这里 → ultralytics 自行下载
VISION_MODEL_DIR=
# 结构光深度（Orbbec Astra Pro）：指向 Astra SDK 的 bin 目录
# （里面有 astra_core.dll / astra.dll）。留空则不用结构光，退回单目方位。
VISION_USE_ASTRA=1
VISION_ASTRA_SDK_DIR=

# ---- 可选调优（不填即用 backend/config.py 默认值） ----
# INTERRUPT_MODE=smart
# TOOL_MAX_PERMISSION=read
# MAX_TURNS=10
# LOG_CONTEXT=1
